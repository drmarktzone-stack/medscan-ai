{
  "name": "Association",
  "type": "object",
  "description": "\u05d0\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d4: \u05de\u05de\u05e6\u05d0-\u05e2\u05d5\u05d2\u05df + \u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05e0\u05dc\u05d5\u05d5\u05d9\u05dd \u2192 \u05d7\u05e9\u05d3 \u05dc\u05de\u05d7\u05dc\u05d4 \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea. \u05de\u05d6\u05d9\u05df Association Alerts \u05d5-Differential Builder.",
  "properties": {
    "assoc_key": {
      "type": "string"
    },
    "anchor_finding_he": {
      "type": "string",
      "description": "\u05d4\u05de\u05de\u05e6\u05d0/\u05d4\u05de\u05d7\u05dc\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9"
    },
    "co_findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05e9\u05de\u05e2\u05dc\u05d9\u05dd \u05d0\u05ea \u05d4\u05d7\u05e9\u05d3"
    },
    "implies_he": {
      "type": "string",
      "description": "\u05d4\u05de\u05d7\u05dc\u05d4/\u05d4\u05db\u05d9\u05d5\u05d5\u05df \u05d4\u05e0\u05dc\u05d5\u05d5\u05d4 \u05e9\u05d9\u05e9 \u05dc\u05d7\u05e9\u05d5\u05d3 \u05d1\u05d5"
    },
    "suspicion": {
      "type": "string",
      "enum": [
        "green",
        "yellow",
        "red"
      ]
    },
    "mechanism_he": {
      "type": "string",
      "description": "\u05de\u05d3\u05d5\u05e2 \u05d4\u05e7\u05e9\u05e8 \u05e7\u05d9\u05d9\u05dd \u2014 \u05d4\u05d4\u05d9\u05d2\u05d9\u05d5\u05df"
    },
    "action_he": {
      "type": "string"
    },
    "age_scope": {
      "type": "string",
      "enum": [
        "neonate",
        "infant",
        "child",
        "adolescent",
        "all"
      ],
      "default": "all"
    },
    "source_anchor": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "draft_needs_verification",
        "verified",
        "flagged"
      ],
      "default": "draft_needs_verification"
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_note_he": {
      "type": "string"
    }
  },
  "required": [
    "assoc_key",
    "anchor_finding_he",
    "implies_he",
    "suspicion",
    "source_anchor"
  ],
  "rls": {
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}