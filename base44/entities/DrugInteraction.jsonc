{
  "name": "DrugInteraction",
  "type": "object",
  "description": "\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9\u05ea \u05de\u05d0\u05d5\u05de\u05ea\u05ea. \u26a0 \u05d9\u05e9\u05d5\u05ea \u05e7\u05e8\u05d9\u05d8\u05d9\u05ea \u05dc\u05d1\u05d8\u05d9\u05d7\u05d5\u05ea: MedScan \u05d0\u05d9\u05e0\u05d5 \u05de\u05e1\u05d9\u05e7 \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d5\u05ea \u05de\u05d4\u05d9\u05d3\u05e2 \u05d4\u05db\u05dc\u05dc\u05d9 \u05e9\u05dc \u05de\u05e0\u05d5\u05e2 \u05d4\u05e9\u05e4\u05d4. \u05d0\u05dd \u05d4\u05d9\u05e9\u05d5\u05ea \u05e8\u05d9\u05e7\u05d4, \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05de\u05e6\u05d4\u05d9\u05e8\u05d4 \u05d1\u05de\u05e4\u05d5\u05e8\u05e9 '\u05dc\u05d0 \u05d1\u05d5\u05e6\u05e2\u05d4 \u05d1\u05d3\u05d9\u05e7\u05ea \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d5\u05ea' \u2014 \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d4 \u05de\u05e0\u05e1\u05d4 \u05dc\u05db\u05e1\u05d5\u05ea \u05e2\u05dc \u05d4\u05d7\u05d5\u05e1\u05e8. \u05e9\u05e7\u05d8 \u05db\u05d0\u05df \u05de\u05e1\u05d5\u05db\u05df \u05d9\u05d5\u05ea\u05e8 \u05de\u05d4\u05d5\u05d3\u05e2\u05d4.",
  "properties": {
    "interaction_key": {
      "type": "string"
    },
    "drug_a": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 (\u05d0\u05d5 \u05e9\u05dd \u05e7\u05d1\u05d5\u05e6\u05d4)"
    },
    "drug_b": {
      "type": "string",
      "description": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05e9\u05e0\u05d9\u05d9\u05d4. \u05e2\u05d1\u05d5\u05e8 \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d9\u05ea \u05ea\u05e8\u05d5\u05e4\u05d4-\u05de\u05e6\u05d1, \u05d4\u05e9\u05d0\u05e8 \u05e8\u05d9\u05e7 \u05d5\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1-condition."
    },
    "condition": {
      "type": "string",
      "description": "\u05de\u05e6\u05d1 \u05e8\u05e7\u05e2 (\u05dc\u05de\u05e9\u05dc \u05d0\u05e1\u05e4\u05dc\u05e0\u05d9\u05d4, \u05d0\u05d9-\u05e1\u05e4\u05d9\u05e7\u05ea \u05db\u05dc\u05d9\u05d5\u05ea) \u05e2\u05d1\u05d5\u05e8 \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d9\u05ea \u05ea\u05e8\u05d5\u05e4\u05d4-\u05de\u05e6\u05d1"
    },
    "severity": {
      "type": "string",
      "enum": [
        "minor",
        "moderate",
        "major",
        "contraindicated"
      ],
      "default": "moderate"
    },
    "effect_he": {
      "type": "string",
      "description": "\u05de\u05d4 \u05e7\u05d5\u05e8\u05d4 \u05d1\u05e4\u05d5\u05e2\u05dc"
    },
    "mechanism_he": {
      "type": "string"
    },
    "management_he": {
      "type": "string",
      "description": "\u05de\u05d4 \u05dc\u05e2\u05e9\u05d5\u05ea \u2014 \u05e0\u05d9\u05d8\u05d5\u05e8, \u05d4\u05ea\u05d0\u05de\u05ea \u05de\u05d9\u05e0\u05d5\u05df, \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea"
    },
    "age_scope": {
      "type": "string",
      "enum": [
        "neonate",
        "infant",
        "child",
        "adolescent",
        "all"
      ],
      "default": "all"
    },
    "source": {
      "type": "string",
      "description": "\u05d7\u05d5\u05d1\u05d4 \u2014 \u05de\u05e1\u05d3 \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d4\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05e9\u05de\u05de\u05e0\u05d5 \u05e0\u05dc\u05e7\u05d7\u05d4 \u05d4\u05e8\u05e9\u05d5\u05de\u05d4"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "draft_needs_verification",
        "verified",
        "flagged"
      ],
      "default": "draft_needs_verification"
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_note_he": {
      "type": "string"
    }
  },
  "required": [
    "interaction_key",
    "drug_a",
    "severity",
    "effect_he",
    "source"
  ],
  "rls": {
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}