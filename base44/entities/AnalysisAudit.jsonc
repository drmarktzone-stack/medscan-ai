{
  "name": "AnalysisAudit",
  "type": "object",
  "description": "\u05d9\u05d5\u05de\u05df \u05d1\u05e7\u05e8\u05d4 \u05dc\u05db\u05dc \u05e8\u05d9\u05e6\u05d4 \u05e9\u05dc \u05de\u05e0\u05d5\u05e2 \u05e7\u05dc\u05d9\u05e0\u05d9. \u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05e2\u05e0\u05d5\u05ea \u05d1\u05d3\u05d9\u05e2\u05d1\u05d3 \u05e2\u05dc \u05d4\u05e9\u05d0\u05dc\u05d4 '\u05dc\u05de\u05d4 \u05d4\u05db\u05dc\u05d9 \u05d0\u05de\u05e8 \u05d0\u05ea \u05d6\u05d4' \u2014 \u05d5\u05dc\u05d6\u05d4\u05d5\u05ea \u05d3\u05e4\u05d5\u05e1\u05d9 \u05db\u05e9\u05dc \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05dd \u05d4\u05d5\u05e4\u05db\u05d9\u05dd \u05dc\u05e0\u05d6\u05e7.",
  "properties": {
    "engine": {
      "type": "string",
      "description": "lab_interpreter / patient_context / protocol_runner / differential / radiology / ecg / skin"
    },
    "status": {
      "type": "string",
      "enum": [
        "full",
        "degraded",
        "insufficient",
        "unknown"
      ],
      "default": "unknown"
    },
    "fact_block_size": {
      "type": "number",
      "description": "\u05db\u05de\u05d4 \u05e2\u05d5\u05d1\u05d3\u05d5\u05ea \u05d4\u05d9\u05d5 \u05d1\u05d2\u05d1\u05d5\u05dc \u05d4\u05d9\u05d3\u05e2"
    },
    "draft_items_rejected": {
      "type": "number",
      "description": "\u05db\u05de\u05d4 \u05e4\u05e8\u05d9\u05d8\u05d9 \u05d8\u05d9\u05d5\u05d8\u05d4 \u05e0\u05d7\u05e1\u05de\u05d5. \u05de\u05e1\u05e4\u05e8 \u05d2\u05d1\u05d5\u05d4 \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df = \u05d4-KB \u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d9\u05de\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9."
    },
    "anchors_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "violation_count": {
      "type": "number"
    },
    "blocking_count": {
      "type": "number"
    },
    "removed_claims": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u05de\u05d4 \u05d4\u05d5\u05e1\u05e8 \u05de\u05d4\u05e4\u05dc\u05d8 \u05d5\u05dc\u05de\u05d4. \u05d4\u05e1\u05e8\u05d4 \u05de\u05d5\u05e6\u05d4\u05e8\u05ea, \u05dc\u05e2\u05d5\u05dc\u05dd \u05dc\u05d0 \u05e9\u05e7\u05d8\u05d4."
    },
    "confidence_adjustments": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u05db\u05dc \u05de\u05e7\u05e8\u05d4 \u05e9\u05d1\u05d5 \u05d4\u05db\u05d9\u05d5\u05dc \u05d4\u05d3\u05d8\u05e8\u05de\u05d9\u05e0\u05d9\u05e1\u05d8\u05d9 \u05d4\u05d5\u05e8\u05d9\u05d3 \u05d0\u05ea \u05d4\u05e6\u05d9\u05d5\u05df \u05e9\u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05e6\u05d9\u05e2"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e7\u05d5\u05d3\u05d9 \u05e1\u05d9\u05e8\u05d5\u05d1: empty_fact_block / no_verified_knowledge / unsourced_critical_numbers / fabricated_attribution / critical_omission / unsafe_input / self_check_failed"
    }
  },
  "required": [
    "engine",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}