{
  "name": "ECGCase",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short name of the ECG pattern"
    },
    "diagnosis": {
      "type": "string",
      "description": "Formal diagnosis"
    },
    "category": {
      "type": "string",
      "enum": [
        "rhythm",
        "conduction",
        "ischemic",
        "chamber_abnormality",
        "electrolyte",
        "syndrome",
        "drug_effect",
        "other"
      ],
      "default": "other"
    },
    "key_features": {
      "type": "string",
      "description": "Hallmark ECG features to look for"
    },
    "diagnostic_criteria": {
      "type": "string",
      "description": "Formal diagnostic criteria checklist \u2014 the specific measurable ECG criteria required to confirm this diagnosis (e.g. intervals, morphology, lead distribution). Used by the criteria-verification stage."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags / keywords for this case (e.g. pediatric, emergency, arrhythmia)"
    },
    "description": {
      "type": "string",
      "description": "Detailed clinical description"
    },
    "image_url": {
      "type": "string",
      "description": "Reference ECG image URL (optional)"
    },
    "urgent": {
      "type": "boolean",
      "description": "Whether this case requires urgent medical intervention or thorough examination",
      "default": false
    }
  },
  "required": [
    "title",
    "diagnosis"
  ]
}