{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "analysis_id": {
      "type": "string",
      "description": "ID of the analysis record this feedback refers to"
    },
    "analysis_type": {
      "type": "string",
      "enum": [
        "ecg",
        "skin"
      ],
      "description": "Type of analysis"
    },
    "is_correct": {
      "type": "boolean",
      "description": "Whether the AI diagnosis was correct"
    },
    "corrected_diagnosis": {
      "type": "string",
      "description": "The correct diagnosis, provided when the AI was wrong"
    },
    "notes": {
      "type": "string",
      "description": "Additional feedback notes"
    }
  },
  "required": [
    "analysis_id",
    "is_correct"
  ]
}