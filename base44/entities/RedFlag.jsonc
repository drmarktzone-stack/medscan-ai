{
  "name": "RedFlag",
  "type": "object",
  "description": "\u05d3\u05d2\u05dc \u05d0\u05d3\u05d5\u05dd \u05ea\u05dc\u05d5\u05d9-\u05d2\u05d9\u05dc. \u05e0\u05d1\u05d3\u05e7 \u05d1\u05e7\u05d5\u05d3 \u05dc\u05e4\u05e0\u05d9 \u05db\u05dc \u05e9\u05d9\u05e7\u05d5\u05dc \u05d0\u05d1\u05d7\u05d5\u05e0\u05d9. \u05de\u05e1\u05db\u05df-\u05d7\u05d9\u05d9\u05dd = \u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05d1\u05e4\u05dc\u05d8. \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 (action_he) \u05de\u05d2\u05d9\u05e2\u05d4 \u05ea\u05de\u05d9\u05d3 \u05de\u05db\u05d0\u05df \u05d5\u05dc\u05e2\u05d5\u05dc\u05dd \u05dc\u05d0 \u05de\u05d4\u05de\u05d5\u05d3\u05dc.",
  "properties": {
    "flag_key": {
      "type": "string"
    },
    "label_he": {
      "type": "string"
    },
    "trigger": {
      "type": "object",
      "description": "\u05d4\u05ea\u05e0\u05d0\u05d9 \u05d4\u05de\u05e4\u05e2\u05d9\u05dc, \u05de\u05e9\u05d5\u05dc\u05d1 \u05e2\u05dd \u05d7\u05dc\u05d5\u05df \u05d4\u05d2\u05d9\u05dc",
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logic": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ],
          "default": "all"
        }
      }
    },
    "age_min_days": {
      "type": "number",
      "description": "\u05d2\u05d1\u05d5\u05dc \u05ea\u05d7\u05ea\u05d5\u05df \u05d1\u05d9\u05de\u05d9\u05dd. \u05dc\u05de\u05e9\u05dc 0"
    },
    "age_max_days": {
      "type": "number",
      "description": "\u05d2\u05d1\u05d5\u05dc \u05e2\u05dc\u05d9\u05d5\u05df \u05d1\u05d9\u05de\u05d9\u05dd. \u05dc\u05de\u05e9\u05dc 28 \u05dc\u05d9\u05dc\u05d5\u05d3"
    },
    "severity": {
      "type": "string",
      "enum": [
        "red",
        "critical"
      ],
      "default": "red"
    },
    "action_he": {
      "type": "string",
      "description": "\u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea. \u05d7\u05d5\u05d1\u05d4 \u2014 \u05d3\u05d2\u05dc \u05d1\u05dc\u05d9 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05d5\u05d0 \u05d0\u05d6\u05d4\u05e8\u05d4 \u05d7\u05e1\u05e8\u05ea \u05e2\u05e8\u05da."
    },
    "reason_he": {
      "type": "string"
    },
    "source_anchor": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "draft_needs_verification",
        "verified",
        "flagged"
      ],
      "default": "draft_needs_verification",
      "description": "\u05d4\u05e2\u05e8\u05d4: \u05d3\u05d2\u05dc \u05d1\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d8\u05d9\u05d5\u05d8\u05d4 \u05e2\u05d3\u05d9\u05d9\u05df \u05de\u05d5\u05e6\u05d2 \u2014 \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05e1\u05d5\u05e0\u05e0\u05ea \u05d4\u05d7\u05d5\u05e6\u05d4 \u2014 \u05d0\u05da \u05de\u05e1\u05d5\u05de\u05df \u05d1\u05d1\u05d9\u05e8\u05d5\u05e8."
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_note_he": {
      "type": "string"
    }
  },
  "required": [
    "flag_key",
    "label_he",
    "trigger",
    "severity",
    "action_he",
    "source_anchor"
  ],
  "rls": {
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}