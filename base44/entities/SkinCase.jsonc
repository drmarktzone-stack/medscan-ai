{
  "name": "SkinCase",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short name of the skin condition"
    },
    "diagnosis": {
      "type": "string",
      "description": "Formal diagnosis"
    },
    "category": {
      "type": "string",
      "enum": [
        "benign",
        "malignant",
        "inflammatory",
        "infectious",
        "autoimmune",
        "pigmentation",
        "vascular",
        "precancerous",
        "other"
      ],
      "default": "other"
    },
    "key_features": {
      "type": "string",
      "description": "Hallmark visual features to look for"
    },
    "diagnostic_criteria": {
      "type": "string",
      "description": "Formal diagnostic criteria checklist \u2014 the specific measurable clinical/dermoscopic criteria required to confirm this diagnosis (e.g. ABCDE criteria, morphology, distribution, dermoscopic structures). Used by the criteria-verification stage."
    },
    "description": {
      "type": "string",
      "description": "Detailed clinical description"
    },
    "image_url": {
      "type": "string",
      "description": "Reference skin image URL (optional)"
    },
    "urgent": {
      "type": "boolean",
      "description": "Whether this case requires urgent medical intervention or thorough examination",
      "default": false
    }
  },
  "required": [
    "title",
    "diagnosis"
  ]
}