{
  "name": "ReferenceRange",
  "type": "object",
  "description": "\u05d8\u05d5\u05d5\u05d7\u05d9 \u05d9\u05d9\u05d7\u05d5\u05e1 \u05e9\u05dc \u05d4\u05de\u05e2\u05d1\u05d3\u05d4 \u05d4\u05de\u05d1\u05e6\u05e2\u05ea. \u26a0 \u05d8\u05d5\u05d5\u05d7\u05d9\u05dd \u05d4\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05dc\u05de\u05e2\u05d1\u05d3\u05d4 \u2014 \u05d4\u05dd \u05ea\u05dc\u05d5\u05d9\u05d9\u05dd \u05d1\u05e9\u05d9\u05d8\u05ea \u05d4\u05de\u05d3\u05d9\u05d3\u05d4, \u05d1\u05de\u05db\u05e9\u05d5\u05e8 \u05d5\u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05ea \u05d4\u05d9\u05d9\u05d7\u05d5\u05e1. \u05d8\u05d5\u05d5\u05d7 \u05de\u05e1\u05e4\u05e8 \u05dc\u05d9\u05de\u05d5\u05d3 \u05e9\u05d9\u05d5\u05e9\u05dd \u05e2\u05dc \u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05de\u05e2\u05d1\u05d3\u05d4 \u05d0\u05d7\u05e8\u05ea \u05d9\u05e1\u05de\u05df '\u05ea\u05e7\u05d9\u05df' \u05de\u05d4 \u05e9\u05d7\u05e8\u05d9\u05d2. \u05e2\u05d3 \u05e9\u05e0\u05d8\u05e2\u05df \u05d8\u05d5\u05d5\u05d7 \u05de\u05d0\u05d5\u05de\u05ea \u05dc\u05de\u05d3\u05d3, \u05d4\u05e2\u05e8\u05da \u05de\u05e1\u05d5\u05de\u05df unknown_range \u2014 \u05d5\u05dc\u05d0 '\u05ea\u05e7\u05d9\u05df'.",
  "properties": {
    "analyte": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d3\u05d3. \u05de\u05d6\u05d4\u05d4 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9."
    },
    "label_he": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "description": "\u05d7\u05d5\u05d1\u05d4 \u05e9\u05d9\u05ea\u05d0\u05d9\u05dd \u05dc\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05e9\u05d1\u05d4\u05df \u05de\u05d5\u05d6\u05e0\u05d5\u05ea \u05d4\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea, \u05d0\u05d7\u05e8\u05ea \u05d4\u05e2\u05e8\u05da \u05dc\u05d0 \u05d9\u05e1\u05d5\u05de\u05df."
    },
    "bands": {
      "type": "array",
      "description": "\u05d8\u05d5\u05d5\u05d7\u05d9\u05dd \u05dc\u05e4\u05d9 \u05d2\u05d9\u05dc \u05d5\u05de\u05d9\u05df. low \u05d0\u05d5 high \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea null (\u05d8\u05d5\u05d5\u05d7 \u05d7\u05d3-\u05e6\u05d3\u05d3\u05d9). \u05dc\u05d2\u05d1\u05d5\u05dc \u05e2\u05dc\u05d9\u05d5\u05df \u05e4\u05ea\u05d5\u05d7: age_max_days 36500.",
      "items": {
        "type": "object",
        "properties": {
          "age_min_days": {
            "type": "number"
          },
          "age_max_days": {
            "type": "number"
          },
          "sex": {
            "type": "string",
            "enum": [
              "any",
              "male",
              "female"
            ],
            "default": "any"
          },
          "low": {
            "type": "number"
          },
          "high": {
            "type": "number"
          }
        },
        "required": [
          "age_min_days",
          "age_max_days"
        ]
      }
    },
    "lab_name": {
      "type": "string",
      "description": "\u05d7\u05d5\u05d1\u05d4 \u2014 \u05e9\u05dd \u05d4\u05de\u05e2\u05d1\u05d3\u05d4 \u05d4\u05de\u05d1\u05e6\u05e2\u05ea \u05d5\u05ea\u05d0\u05e8\u05d9\u05da \u05d2\u05d9\u05dc\u05d9\u05d5\u05df \u05d4\u05d8\u05d5\u05d5\u05d7\u05d9\u05dd"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "draft_needs_verification",
        "verified",
        "flagged"
      ],
      "default": "draft_needs_verification"
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_note_he": {
      "type": "string"
    }
  },
  "required": [
    "analyte",
    "unit",
    "bands",
    "lab_name"
  ],
  "rls": {
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}