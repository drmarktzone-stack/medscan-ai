{
  "name": "RadiologyCase",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short name of the radiological finding"
    },
    "diagnosis": {
      "type": "string",
      "description": "Formal diagnosis"
    },
    "category": {
      "type": "string",
      "enum": [
        "chest",
        "abdominal",
        "musculoskeletal",
        "neurological",
        "cardiac",
        "vascular",
        "genitourinary",
        "other"
      ],
      "default": "other"
    },
    "key_features": {
      "type": "string",
      "description": "Hallmark radiological features to look for"
    },
    "diagnostic_criteria": {
      "type": "string",
      "description": "Formal diagnostic criteria checklist \u2014 the specific measurable radiological criteria required to confirm this diagnosis (e.g. density, size, margins, location, mass effect, associated signs). Used by the criteria-verification stage."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags / keywords for this case (e.g. pediatric, emergency, CT, chest, trauma)"
    },
    "description": {
      "type": "string",
      "description": "Detailed clinical description"
    },
    "image_url": {
      "type": "string",
      "description": "Reference radiology image URL (optional)"
    },
    "urgent": {
      "type": "boolean",
      "description": "Whether this case requires urgent medical intervention or thorough examination",
      "default": false
    }
  },
  "required": [
    "title",
    "diagnosis"
  ]
}