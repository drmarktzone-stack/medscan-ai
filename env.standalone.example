# Standalone build — copy to .env.standalone for local builds
VITE_STANDALONE=true

# Optional: email/password auth (free Supabase tier)
# Create project at https://supabase.com → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Site URL for password reset emails (Supabase Auth → URL configuration)
# Add: https://your-domain.com/medscan-ai/reset-password

# Bit (ביט) — merchant mobile for manual transfers (never commit real number to git)
# Production: set GitHub Secret BIT_MERCHANT_PHONE in repo Settings → Secrets
VITE_BIT_MERCHANT_PHONE=

# Vision subscription price in ILS (default 49)
VITE_VISION_PRICE_ILS=49

# Optional: Stripe Payment Link (card checkout alternative)
# VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/...

# Optional: public site URL for share links (defaults to current origin)
# VITE_PUBLIC_SITE_URL=https://drmarktzone-stack.github.io/medscan-ai

# Vision subscription unlock code — send to customers after Bit payment verified
# GitHub Secret: VISION_UNLOCK_CODE
# VITE_VISION_UNLOCK_CODE=your_secret_code

# Paywall for imaging routes (default: true when Bit phone is set)
# VITE_VISION_PAYWALL=true

# Subscription length in days (default 30)
# VITE_VISION_SUBSCRIPTION_DAYS=30
# VITE_SUPPORT_WHATSAPP=0528885800
# VITE_GROW_USER_ID=
# VITE_GROW_BIT_PAGE_CODE=

# FreeAI Pro payments (optional — Bit defaults to 0528885800 if omitted)
# VITE_FREEAI_BIT_PHONE=0528885800
# VITE_FREEAI_SUPPORT_WHATSAPP=972528885800
# VITE_FREEAI_PUBLIC_URL=https://drmarktzone-stack.github.io/medscan-ai

# FreeAI Chat — free Groq key from https://console.groq.com (recommended)
# VITE_GROQ_API_KEY=gsk_...
# Optional: Pollinations text — https://enter.pollinations.ai/keys
# VITE_POLLINATIONS_API_KEY=sk_...
# Optional: Google Gemini — https://aistudio.google.com/app/apikey
# VITE_GOOGLE_AI_API_KEY=AQ....
# Optional: DeepSeek — https://platform.deepseek.com/api_keys
# VITE_DEEPSEEK_API_KEY=sk-...

# Production (GitHub Pages): add repo Secrets GROQ_API_KEY, GOOGLE_AI_API_KEY, DEEPSEEK_API_KEY
# Settings → Secrets and variables → Actions → New repository secret
